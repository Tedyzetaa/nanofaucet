# Copie para .env e preencha localmente. NUNCA commite o .env de verdade.

# --- Ambiente ---
# "development" (padrão) permite captcha em modo dev (sem HCAPTCHA_SECRET)
# e expõe /docs. "production" falha ao subir sem HCAPTCHA_SECRET e esconde /docs.
ENVIRONMENT=development

# --- Banco de dados ---
# vazio = SQLite local (dev). Em produção, connection string do pooler do
# Supabase (porta 6543, modo transaction) — NUNCA a porta 5432 direta.
DATABASE_URL=

# --- Faucet ---
CLAIM_AMOUNT=0.00000010
COOLDOWN_SECONDS=60
IP_COOLDOWN_SECONDS=5
MAX_CLAIMS_PER_IP_PER_DAY=50
DRY_RUN=true

# --- FaucetPay ---
FAUCETPAY_API_KEY=
FAUCETPAY_CURRENCY=MATIC

# --- hCaptcha ---
# a SECRET key (privada, painel hCaptcha) — NUNCA o sitekey (público, vai no HTML)
HCAPTCHA_SECRET=

# --- CORS ---
ALLOWED_ORIGINS=https://nanofaucet-green.vercel.app,http://localhost:5500

# --- Supabase Auth (painel admin) ---
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# --- Observabilidade (opcional) ---
# DSN do projeto no Sentry. Vazio = desabilitado.
SENTRY_DSN=

LOG_LEVEL=INFO
